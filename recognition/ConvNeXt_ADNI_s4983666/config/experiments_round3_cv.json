        "fold": 3
      }
    },
    {
      "id": "CV_tiny_context_fold4",
      "purpose": "ConvNeXt-Tiny, three-slice context, fold 4.",
      "args": {
        "model": "convnext_tiny",
        "fold": 4
      }
    },
    {
      "id": "CV_tiny_context_fold5",
