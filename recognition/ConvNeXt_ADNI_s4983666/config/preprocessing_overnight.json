{
  "schema_version": 1,
  "name": "preprocessing_overnight_v1",
  "cases": [
    {
      "id": "P00_none",
      "purpose": "Historical input control.",
      "overrides": {
        "preprocessing": "none"
      }
    },
    {
      "id": "P01_intensity",
      "purpose": "Isolate scan intensity normalization without cropping.",
      "overrides": {
        "preprocessing": "scan_intensity"
      }
    },
    {
      "id": "P02_crop",
      "purpose": "Isolate scan centering/canvas change without intensity normalization.",
      "overrides": {
        "preprocessing": "scan_crop"
      }
    },
    {
      "id": "P03_reference",
      "purpose": "Combined normalization and native crop reference.",
      "overrides": {}
    },
    {
      "id": "A01_integer_shift",
      "purpose": "Train-only integer shifts without interpolation.",
      "overrides": {
        "augmentation": "integer_shift",
        "translation_pixels": 4
      }
    },
    {
      "id": "A02_gamma",
      "purpose": "Train-only mild gamma LUT, range 0.9 to 1.1.",
      "overrides": {
        "augmentation": "gamma"
      }
    },
    {
      "id": "A03_integer_gamma",
      "purpose": "Combine the two separately tested augmentations.",
      "overrides": {
        "augmentation": "integer_gamma",
        "translation_pixels": 4
      }
    },
    {
      "id": "H01_lr_low",
      "purpose": "Change only constant learning rate.",
      "overrides": {
        "lr": 3e-05
      }
    },
    {
      "id": "H02_lr_high",
      "purpose": "Change only constant learning rate.",
      "overrides": {
        "lr": 0.0003
      }
    },
    {
      "id": "H03_decay",
      "purpose": "Change only AdamW weight decay.",
      "overrides": {
        "weight_decay": 0.2
      }
    },
    {
      "id": "H04_cosine",
      "purpose": "Change only learning-rate trajectory.",
      "overrides": {
        "lr_schedule": "warmup_cosine",
        "warmup_epochs": 2,
        "min_lr_ratio": 0.01
      }
    },
    {
      "id": "S01_patient_balance",
      "purpose": "Equalize class/patient sampling mass; sampler also sets BCE class prior to one.",
      "overrides": {
        "sampling": "class_patient_balanced"
      }
    },
    {
      "id": "C01_combined",
      "purpose": "Prospective combination; its components have individual controls.",
      "overrides": {
        "augmentation": "integer_gamma",
        "translation_pixels": 4,
        "lr_schedule": "warmup_cosine",
        "sampling": "class_patient_balanced"
      }
    },
    {
      "id": "R4710_reference",
      "purpose": "Paired seed repeat of P03_reference.",
      "overrides": {
        "seed": 4710
      }
    },
    {
      "id": "R4710_combined",
      "purpose": "Paired seed repeat of C01_combined.",
      "overrides": {
        "seed": 4710,
        "augmentation": "integer_gamma",
        "translation_pixels": 4,
        "lr_schedule": "warmup_cosine",
        "sampling": "class_patient_balanced"
      }
    },
    {
      "id": "R5710_reference",
      "purpose": "Paired seed repeat of P03_reference.",
      "overrides": {
        "seed": 5710
      }
    },
    {
      "id": "R5710_combined",
      "purpose": "Paired seed repeat of C01_combined.",
      "overrides": {
        "seed": 5710,
        "augmentation": "integer_gamma",
        "translation_pixels": 4,
        "lr_schedule": "warmup_cosine",
        "sampling": "class_patient_balanced"
      }
    },
    {
      "id": "L01_reference_60",
      "purpose": "Longer budget control; same initialization/base optimizer as P03.",
      "overrides": {
        "epochs": 60,
        "patience": 60
      }
    }
  ]
}
